generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Enums ─────────
enum Role {
  SUPER_ADMIN
  GENERAL_SECRETARY
  WING_LEAD
  PUBLICATION_EDITOR
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum WingRole {
  LEAD
  CORE
  MEMBER
}

enum EventType {
  HACKATHON
  WORKSHOP
  COURSE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
  WAITLIST
}

enum CertType {
  PARTICIPANT
  WINNER
  EXECUTIVE
  COURSE
}

enum CertStatus {
  VALID
  REVOKED
}

enum ReviewStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum HofCategory {
  ICPC
  NCPC
  HACKATHON
  GSOC
  ALUMNI
}

enum NoticeCategory {
  RECRUITMENT
  COMMITTEE
  CONTEST
  CAMPUS
  URGENT
}

enum ResourceType {
  CP_SHEET
  ROADMAP
  GITHUB_REPO
  INTERVIEW_GUIDE
}

enum SponsorKind {
  PARTNER
  SPONSOR
  FACULTY_ADVISOR
}

enum AlbumCategory {
  ORIENTATION
  CONTEST
  TECH_FEST
  OTHER
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  REVOKE
  REISSUE
  PUBLISH
  LOGIN
  EXPORT
}

// ───────── Admin users (JWT sessions; no auth tables) ─────────
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  role      Role?
  wingId    String?
  wing      Wing?      @relation("WingStaff", fields: [wingId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  audits    AuditLog[]
}

// ───────── Membership ─────────
model Member {
  id            String         @id @default(cuid())
  studentId     String         @unique
  name          String
  email         String         @unique
  batch         String?
  phone         String?
  wingPref      Wing?          @relation("WingPref", fields: [wingPrefId], references: [id])
  wingPrefId    String?
  status        MemberStatus   @default(PENDING)
  memberCardNo  String?        @unique
  cardIssuedAt  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  wingRoles     WingMember[]
  registrations Registration[]
}

// ───────── Committee ─────────
model ExecSession {
  id        String            @id @default(cuid())
  year      Int               @unique
  label     String
  isCurrent Boolean           @default(false)
  archived  Boolean           @default(false)
  members   CommitteeMember[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model CommitteeMember {
  id          String      @id @default(cuid())
  sessionId   String
  session     ExecSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name        String
  title       String
  batch       String?
  photoUrl    String?
  socialLinks Json?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([sessionId, order])
}

// ───────── Wings ─────────
model Wing {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  description      String
  responsibilities String[]
  syllabusUrl      String?
  members          WingMember[]
  staff            User[]       @relation("WingStaff")
  prefs            Member[]     @relation("WingPref")
  events           Event[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model WingMember {
  id       String   @id @default(cuid())
  wingId   String
  memberId String
  role     WingRole @default(MEMBER)
  wing     Wing     @relation(fields: [wingId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([wingId, memberId])
}

// ───────── Events, registrations, certificates ─────────
model Event {
  id            String         @id @default(cuid())
  type          EventType
  slug          String         @unique
  title         String
  description   String
  syllabus      Json?
  startsAt      DateTime
  endsAt        DateTime?
  capacity      Int            @default(0)
  seatsTaken    Int            @default(0)
  status        PublishStatus  @default(DRAFT)
  wingId        String?
  wing          Wing?          @relation(fields: [wingId], references: [id])
  registrations Registration[]
  certificates  Certificate[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Registration {
  id          String             @id @default(cuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId    String?
  member      Member?            @relation(fields: [memberId], references: [id])
  name        String
  email       String
  status      RegistrationStatus @default(CONFIRMED)
  qrToken     String             @unique
  checkedInAt DateTime?
  createdAt   DateTime           @default(now())

  @@unique([eventId, email])
}

model Certificate {
  id             String     @id @default(cuid())
  certId         String     @unique
  recipientName  String
  recipientEmail String?
  type           CertType
  eventId        String?
  event          Event?     @relation(fields: [eventId], references: [id])
  status         CertStatus @default(VALID)
  pdfUrl         String?
  issuedAt       DateTime   @default(now())
  revokedAt      DateTime?
  revokeReason   String?

  @@unique([eventId, recipientEmail, type])
}

// ───────── Publications ─────────
model MagazineIssue {
  id          String    @id @default(cuid())
  number      Int       @unique
  title       String
  pdfUrl      String
  coverUrl    String?
  featured    Boolean   @default(false)
  publishedAt DateTime?
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id          String         @id @default(cuid())
  title       String
  body        String
  authorName  String
  authorEmail String?
  status      ReviewStatus   @default(SUBMITTED)
  issueId     String?
  issue       MagazineIssue? @relation(fields: [issueId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ───────── Projects, Hall of Fame ─────────
model Project {
  id           String       @id @default(cuid())
  title        String
  description  String
  githubUrl    String
  demoUrl      String?
  techStack    String[]
  contributors String[]
  tags         String[]
  status       ReviewStatus @default(SUBMITTED)
  featured     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model HallOfFameEntry {
  id          String      @id @default(cuid())
  category    HofCategory
  title       String
  personName  String
  year        Int
  description String?
  imageUrl    String?
  verified    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ───────── Notices, resources, sponsors, gallery, FAQ, contact ─────────
model Notice {
  id        String         @id @default(cuid())
  title     String
  body      String
  category  NoticeCategory
  pinned    Boolean        @default(false)
  publishAt DateTime       @default(now())
  expireAt  DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([publishAt, expireAt])
}

model Resource {
  id        String       @id @default(cuid())
  type      ResourceType
  title     String
  url       String
  tags      String[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Sponsor {
  id         String      @id @default(cuid())
  kind       SponsorKind
  name       String
  logoUrl    String?
  websiteUrl String?
  tier       String?
  bio        String?
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model GalleryAlbum {
  id        String         @id @default(cuid())
  title     String
  category  AlbumCategory
  coverUrl  String?
  photos    GalleryPhoto[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model GalleryPhoto {
  id      String       @id @default(cuid())
  albumId String
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url     String
  caption String?
  order   Int          @default(0)
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
}

// ───────── Audit (APPEND-ONLY — see prisma/sql/audit_append_only.sql) ─────────
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  actorEmail String?
  action     AuditAction
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime    @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// Shared across app instances so a public form cannot be flooded by rotating processes.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
