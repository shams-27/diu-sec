{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "README.md",
    "AGENTS.md",
    "docs/DECISIONS.md"
  ],
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" }
  ]
}