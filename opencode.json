{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "README.md",
    "AGENTS.md",
    "docs/DECISIONS.md"
  ],
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "pnpm *": "allow",
      "npx prisma *": "allow",
      "python3 .opencode/skills/*": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "rm -rf *": "ask",
      "git push*": "ask",
      "*": "ask"
    }
  }
}